{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.company-intel/schemas/domain-plan-v2.schema.json",
  "title": "Career or Venture DomainPlan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_kind",
    "plan_id",
    "revision",
    "generated_at",
    "subject",
    "constraints",
    "objectives",
    "actions",
    "evidence_bundle_refs",
    "unresolved"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "plan_kind": {
      "enum": [
        "career",
        "venture"
      ]
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "time_hours_per_week",
        "budget",
        "location",
        "risk_tolerance",
        "available_resources"
      ],
      "properties": {
        "time_hours_per_week": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "risk_tolerance": {
          "type": [
            "string",
            "null"
          ]
        },
        "available_resources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "budget": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "amount",
            "currency"
          ],
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "description",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "proposed",
              "ready",
              "blocked",
              "complete"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "evidence_bundle_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "campaign_link": {
      "type": [
        "string",
        "null"
      ]
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
