{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.company-intel/schemas/evidence-bundle.schema.json",
  "title": "Portable evidence bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "generated_at", "producer", "subject", "sources", "claims", "redaction_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bundle_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "locator", "observed_at", "content_hash", "rights_status"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "rights_status": {"enum": ["verified-reusable", "restricted", "unknown"]}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement", "source_ids", "confidence", "status"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "status": {"enum": ["observed", "inferred", "conflicted", "unknown"]}
        }
      }
    },
    "redaction_status": {"enum": ["none", "redacted", "review-required"]}
  }
}
