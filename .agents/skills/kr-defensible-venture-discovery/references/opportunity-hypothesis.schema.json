{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.company-intel/schemas/opportunity-hypothesis.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hypothesis_id", "revision", "sector", "problem", "buyer", "user", "payer", "solution", "market_archetype", "market_sizing", "competitors", "substitutes", "barriers", "data_rights", "evidence_refs", "unresolved", "experiments", "kill_criteria"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "sector": {"type": "string", "minLength": 1},
    "problem": {"type": "string", "minLength": 1},
    "buyer": {"type": "string", "minLength": 1},
    "user": {"type": "string", "minLength": 1},
    "payer": {"type": "string", "minLength": 1},
    "solution": {"type": "string", "minLength": 1},
    "market_archetype": {"enum": ["competitive", "niche", "unverified-white-space"]},
    "market_sizing": {"type": "object", "required": ["tam", "sam", "som", "unit", "formula", "assumptions"]},
    "competitors": {"type": "array", "items": {"type": "object", "required": ["name", "relationship", "evidence_refs"]}},
    "substitutes": {"type": "array", "items": {"type": "string"}},
    "barriers": {"type": "array", "items": {"type": "object", "required": ["kind", "claim", "acquisition_path", "cost_time", "verification", "copyability_risk"]}},
    "data_rights": {"type": "array", "items": {"type": "object", "required": ["source_ref", "acquisition", "analysis", "product_use", "personal_data", "refresh_cost"]}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unresolved": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "experiments": {"type": "array", "items": {"type": "string"}},
    "kill_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
