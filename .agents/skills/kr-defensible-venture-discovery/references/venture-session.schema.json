{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.company-intel/schemas/venture-session.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "revision", "mode", "generated_at", "founder_constraints", "target_sectors", "non_goals", "hypothesis_refs", "evidence_bundle_refs", "research_gaps"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "session_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "mode": {"enum": ["CONFIGURE", "BASELINE", "GAP", "AUGMENT", "RECLASSIFY", "DECIDE"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "founder_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_hours_per_week", "budget_krw", "location", "risk_tolerance", "available_resources", "field_access", "hardware_tolerance", "regulatory_tolerance", "sales_horizon_months", "desired_barriers", "runway_months", "hardware_prototype_budget_krw", "certifications", "forbidden_paths"],
      "properties": {
        "time_hours_per_week": {"type": ["number", "null"], "minimum": 0},
        "budget_krw": {"type": ["number", "null"], "minimum": 0},
        "location": {"type": ["string", "null"]},
        "risk_tolerance": {"type": ["string", "null"]},
        "available_resources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "field_access": {"type": ["string", "null"]},
        "hardware_tolerance": {"type": ["string", "null"]},
        "regulatory_tolerance": {"type": ["string", "null"]},
        "sales_horizon_months": {"type": ["number", "null"], "minimum": 0},
        "desired_barriers": {"type": "array", "items": {"enum": ["physical", "algorithmic", "workflow", "data", "distribution"]}, "uniqueItems": true},
        "runway_months": {"type": ["number", "null"], "minimum": 0},
        "hardware_prototype_budget_krw": {"type": ["number", "null"], "minimum": 0},
        "certifications": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "forbidden_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "target_sectors": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "non_goals": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "hypothesis_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_bundle_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "research_gaps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
